# ProjectAchilles - Docker Environment Configuration
# Copy this file to .env and customize for your deployment
#
# These values override docker-compose.yml defaults
# For standalone (./start.sh), use backend/.env instead

# ============ Clerk Authentication (required) ============
# Read by the frontend container at startup and written to /env-config.js.
# frontend/.env is NOT used in Docker; without this the UI shows a black page
# with "Missing publishableKey" in the browser console.
CLERK_PUBLISHABLE_KEY=pk_test_...

# ============ CORS Configuration ============
# The exact URL you open in the browser, including the port if not 80.
# Overrides CORS_ORIGIN in backend/.env (docker-compose.yml sets it explicitly).
# Default: http://localhost (for local Docker deployment)
# CORS_ORIGIN=https://your-frontend.ngrok.app

# ============ Agent Configuration ============
# External URL where agents connect to the backend
# Required when using ngrok or deploying to a public URL
# AGENT_SERVER_URL=https://your-backend.ngrok.app

# ============ Tunnel Domains (for ./start.sh --tunnel) ============
# These are used by start.sh, not Docker
# NGROK_FRONTEND_DOMAIN=your-app.ngrok.app
# NGROK_BACKEND_DOMAIN=your-api.ngrok.app

# ============ Microsoft Defender Integration (optional) ============
# Passed through to the backend container; overrides the
# Settings → Integrations UI configuration when set.
# DEFENDER_TENANT_ID=00000000-0000-0000-0000-000000000000
# DEFENDER_CLIENT_ID=00000000-0000-0000-0000-000000000000
# DEFENDER_CLIENT_SECRET=your-defender-client-secret
# DEFENDER_TENANT_LABEL=Production Tenant
# Certificate authentication (takes precedence over DEFENDER_CLIENT_SECRET):
# DEFENDER_CERT_THUMBPRINT=0000000000000000000000000000000000000000
# DEFENDER_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ============ CrowdStrike Falcon Integration (optional) ============
# Passed through to the backend container; overrides the
# Settings → Integrations UI configuration when set.
# Required scopes: Alerts: read (add Alerts: write for auto-resolve;
# Zero Trust Assessment: read for the posture score — requires Falcon Insight).
# Regions: us-1 (default) https://api.crowdstrike.com ·
# us-2 https://api.us-2.crowdstrike.com · eu-1 https://api.eu-1.crowdstrike.com ·
# us-gov-1 https://api.laggar.gcw.crowdstrike.com
# Configuration is region-only (no custom base URLs).
# CROWDSTRIKE_REGION=us-1
# CROWDSTRIKE_CLIENT_ID=00000000000000000000000000000000
# CROWDSTRIKE_CLIENT_SECRET=your-crowdstrike-client-secret
# CROWDSTRIKE_LABEL=Production Falcon

# ============ Sophos Central Integration (optional) ============
# Environment variables override the Settings → Integrations UI configuration
# (the UI then cannot change or disconnect Sophos).
# Create a TENANT API credential in Sophos Central → Global Settings → API
# Credentials Management (partner/organization credentials are rejected).
# Role: "Service Principal Read-Only" is enough to sync alerts, SIEM events,
# XDR detections, Health Check and endpoint posture. Auto-resolve in Response
# mode needs "Service Principal Management" (or Super Admin).
# SOPHOS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# SOPHOS_CLIENT_SECRET=your-sophos-client-secret
# SOPHOS_PERMISSION_MODE=read_only   # read_only (default) | response
# SOPHOS_LABEL=Production Sophos
