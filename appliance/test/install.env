# Unattended install config for the appliance boot test (MODE=full) only.
# test/boot-test.sh copies it into the throwaway test VM as /tmp/install.env.
# The Clerk keys are placeholders, not credentials: they pass the installer's
# offline key check (a pk_test_ key for boot-test.clerk.accounts.dev and an
# sk_test_ key). Sign-in can't work, but the backend still starts and its
# /api/health (no Clerk call) must answer: the boot test requires it.
ACHILLES_DOMAIN='achilles.test'
TLS_MODE='internal'
# QEMU user-mode networking always leases the guest 10.0.2.15. HOSTS_ENTRY
# needs it, so the VM resolves achilles.test for the health check.
CADDY_BIND_IP='10.0.2.15'
HOSTS_ENTRY='true'
CLERK_PUBLISHABLE_KEY='pk_test_Ym9vdC10ZXN0LmNsZXJrLmFjY291bnRzLmRldiQ'
CLERK_SECRET_KEY='sk_test_appliancebootestplaceholder0000000000'
# Empty: no Clerk API call after the install.
ADMIN_EMAIL=''
ES_MODE='self'
SEED_ES='false'
