# ProjectAchilles appliance image: Ubuntu 24.04 cloud image -> sealed qcow2.
# Run through `make -C appliance image`, never directly: the Makefile refuses
# a dirty tree and bundles the repo, and build/build-image.sh (in the builder
# container) generates the build password and moves the qcow2 into out/.
#
# The Packer plugin pin is in plugins.pkr.hcl (same directory; Packer loads
# both: build-image.sh builds the directory).

variable "version" {
  type        = string
  description = "Image version (git describe --tags --always --dirty)."
}

variable "commit" {
  type        = string
  description = "Full commit the image's repo checkout is detached at."
}

variable "out_dir" {
  type        = string
  description = "Absolute path of appliance/out."
}

variable "ssh_password" {
  type        = string
  sensitive   = true
  description = "Per-build random password for the achilles build user, for the SSH communicator only. Generated by build-image.sh; locked by the seal."
}

variable "ssh_password_hash" {
  type        = string
  sensitive   = true
  description = "SHA-512 crypt hash of ssh_password: the only form the seed (and so the VM) gets."
}

locals {
  # Absolute: file() resolves relative paths against the template directory,
  # provisioners against the working directory.
  dir        = abspath(path.root)
  base_image = "ubuntu-24.04-server-cloudimg-amd64.img"
  vm_name    = "achilles-appliance-${var.version}.qcow2"
  script_env = [
    "ACHILLES_COMMIT=${var.commit}",
    "ACHILLES_VERSION=${var.version}",
    "DEBIAN_FRONTEND=noninteractive",
    # sudo -E would otherwise keep HOME=/home/achilles, and root-owned dot
    # directories (.gnupg, .docker) would land in the admin's home.
    "HOME=/root",
  ]
  sudo_exec = "{{ .Vars }} sudo -E bash '{{ .Path }}'"
}

source "qemu" "appliance" {
  # base
  disk_image   = true
  iso_url      = "${var.out_dir}/${local.base_image}"
  iso_checksum = "file:${var.out_dir}/SHA256SUMS"
  disk_size    = "80G"
  format       = "qcow2"
  # fstrim in the seal then reaches the qcow2, and the final compaction drops it.
  disk_interface = "virtio"
  disk_discard   = "unmap"

  # machine
  accelerator       = "kvm"
  cpus              = 4
  memory            = 8192
  machine_type      = "q35"
  efi_boot          = true
  efi_firmware_code = "/usr/share/OVMF/OVMF_CODE_4M.fd"
  efi_firmware_vars = "/usr/share/OVMF/OVMF_VARS_4M.fd"
  headless          = true
  net_device        = "virtio-net"
  # Kernel and cloud-init output (the image's cmdline has console=ttyS0).
  qemuargs = [["-serial", "file:${var.out_dir}/serial.log"]]

  # seed: cloud-init NoCloud datasource
  cd_label = "cidata"
  cd_content = {
    "meta-data" = file("${local.dir}/seed/meta-data")
    "user-data" = templatefile("${local.dir}/seed/user-data.pkrtpl", { password_hash = var.ssh_password_hash })
  }

  # access
  communicator     = "ssh"
  ssh_username     = "achilles"
  ssh_password     = var.ssh_password
  ssh_timeout      = "20m"
  shutdown_command = "sudo shutdown -P now"
  shutdown_timeout = "10m"

  # output (build-image.sh moves the qcow2 up into out/)
  output_directory = "${var.out_dir}/packer-${var.version}"
  vm_name          = local.vm_name
}

build {
  sources = ["source.qemu.appliance"]

  provisioner "file" {
    source      = "${var.out_dir}/achilles-installer"
    destination = "/tmp/achilles-installer"
  }

  provisioner "file" {
    source      = "${var.out_dir}/repo.bundle"
    destination = "/tmp/repo.bundle"
  }

  # No trailing slash: uploads the directory itself, as /tmp/rootfs.
  provisioner "file" {
    source      = "${local.dir}/../rootfs"
    destination = "/tmp"
  }

  provisioner "shell" {
    environment_vars = local.script_env
    execute_command  = local.sudo_exec
    scripts = [
      "${local.dir}/provision/10-base.sh",
      "${local.dir}/provision/20-docker.sh",
      "${local.dir}/provision/30-repo.sh",
      "${local.dir}/provision/40-images.sh",
      "${local.dir}/provision/50-rootfs.sh",
    ]
  }

  provisioner "shell" {
    environment_vars = local.script_env
    execute_command  = local.sudo_exec
    script           = "${local.dir}/seal.sh"
  }
}
