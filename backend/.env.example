# =============================================================================
# ProjectAchilles Backend Configuration
# =============================================================================
# Copy to .env and fill in your values:  cp .env.example .env
# Or run the interactive wizard:         ./setup.sh

# ======================== Authentication (required) ==========================
# Get keys from https://dashboard.clerk.com → Your App → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ======================== Server =============================================
PORT=3000
NODE_ENV=development

# ======================== Organization =======================================
# Optional. The organization this deployment serves, printed on the execution
# report (Analytics > All Executions > Export > Report (PDF)): the cover, the
# scope table and every page header. Unset, the report says "All organizations".
# Longer than 56 characters is cut with an ellipsis. A full name saved in
# Settings > General (console identity), or CONSOLE_ORG_NAME, takes precedence.
# ORGANIZATION_NAME=Acme Corp
#
# Optional console identity (a saved Settings value replaces all three). Code: 2-6 letters/digits.
# CONSOLE_ORG_CODE=ACME
# CONSOLE_ORG_NAME=Acme Financial Group   # falls back to ORGANIZATION_NAME
# CONSOLE_ORG_COLOR=violet   # violet|indigo|blue|cyan|fuchsia|pink|orange|silver|none
#
# Optional. Display names for organization UUIDs (routing.oid) in Analytics,
# the execution report and the compliance export, as JSON keyed by org UUID.
# A value is a short name or {"shortName","fullName"}. Orgs without one show
# the first 8 characters of their UUID.
# ORG_NAMES={"<org-uuid>":{"shortName":"ACME","fullName":"Acme Corporation"}}

# ======================== Secrets ============================================
# Session signing key (generate: openssl rand -base64 32)
SESSION_SECRET=

# Encryption key for settings at rest (analytics credentials, cert passwords)
# Required for Docker/PaaS where hostname is not stable across restarts
# If not set, falls back to machine-derived key (hostname + username)
# ENCRYPTION_SECRET=change-me-to-a-secure-random-string

# CLI authentication secret (required for `achilles login` CLI command)
# Generate: openssl rand -base64 32
# CLI_AUTH_SECRET=

# ======================== CORS ===============================================
# For Docker:       http://localhost
# For local dev:    http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ======================== Agent Communication ================================
# External URL for agent communication (used in enrollment commands)
# Default below works for local Docker/dev. Override with your public URL when
# deploying (e.g. https://<your-backend>.up.railway.app, a tunnel, or a reverse proxy).
AGENT_SERVER_URL=http://localhost:3000

# ======================== Tunnel (for ./start.sh --tunnel) ===================
# Optional — only needed if you expose the app via an ngrok tunnel.
# Requires ngrok paid plan — get domains at: https://dashboard.ngrok.com/domains
# NGROK_FRONTEND_DOMAIN=your-app.ngrok.app
# NGROK_BACKEND_DOMAIN=your-api.ngrok.app

# ======================== Test Repository ====================================
# Git-synced repository — uncomment and set your repo URL to enable
# TESTS_REPO_URL=https://github.com/ubercylon8/f0_library.git
# TESTS_REPO_BRANCH=main
# TESTS_LOCAL_PATH=./data/f0_library

# GitHub Personal Access Token (optional — only needed for private repos)
# Public repos (including the default f0_library) work without a token.
# Generate at: https://github.com/settings/tokens — scopes: repo
# GITHUB_TOKEN=ghp_xxxxx

# Fallback: direct path if TESTS_REPO_URL is not set
TESTS_SOURCE_PATH=../../f0_library/tests_source

# ======================== Agent Repository ====================================
# Git-synced agent source (required for Railway — the agent/ dir is not in the Docker image)
# AGENT_REPO_URL=https://github.com/projectachilles/ProjectAchilles.git
# AGENT_REPO_BRANCH=main
# AGENT_LOCAL_PATH=./data/agent-source
#
# Fallback: direct path if AGENT_REPO_URL is not set
# AGENT_SOURCE_PATH=../../agent

# ======================== Elasticsearch (Analytics) ==========================
# Environment variables override file-based config (~/.projectachilles/analytics.json)
# Choose ONE of the three options below.

# --- Option 1: Local Docker instance (via docker compose --profile elasticsearch)
# ELASTICSEARCH_NODE=http://elasticsearch:9200
# ELASTICSEARCH_INDEX_PATTERN=achilles-results-*

# --- Option 2: Elastic Cloud
# ELASTICSEARCH_CLOUD_ID=my-deployment:dXMtY2VudHJhbDEuZ2NwLmNsb3VkLmVzLmlvJGFiY2QxMjM0
# ELASTICSEARCH_API_KEY=base64_encoded_api_key

# --- Option 3: Self-hosted / Direct connection
# ELASTICSEARCH_NODE=https://your-es-host:9200
# ELASTICSEARCH_API_KEY=base64_encoded_api_key
# Or use basic auth instead of API key:
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=changeme

# Index pattern for analytics queries (default: achilles-results-*)
# ELASTICSEARCH_INDEX_PATTERN=achilles-results-*

# ======================== Microsoft Defender Integration (optional) ==========
# Environment variables override the Settings → Integrations UI configuration.
# Create an App Registration in Azure AD with SecurityAlert.Read.All
# (Application type, admin consent); add SecurityAlert.ReadWrite.All only if
# you plan to enable alert auto-resolve.
# DEFENDER_TENANT_ID=00000000-0000-0000-0000-000000000000
# DEFENDER_CLIENT_ID=00000000-0000-0000-0000-000000000000
# DEFENDER_CLIENT_SECRET=your-defender-client-secret
# DEFENDER_TENANT_LABEL=Production Tenant
#
# Certificate authentication (takes precedence over DEFENDER_CLIENT_SECRET):
# DEFENDER_CERT_THUMBPRINT=0000000000000000000000000000000000000000
# DEFENDER_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ======================== CrowdStrike Falcon Integration (optional) ==========
# Environment variables override the Settings → Integrations UI configuration.
# Create an API client in the Falcon console → Support → API Clients and Keys.
# Required scopes: Alerts: read (add Alerts: write for auto-resolve;
# Zero Trust Assessment: read for the posture score — requires Falcon Insight).
# Base URLs by region: us-1 https://api.crowdstrike.com (default),
# us-2 https://api.us-2.crowdstrike.com, eu-1 https://api.eu-1.crowdstrike.com,
# us-gov-1 https://api.laggar.gcw.crowdstrike.com
# Configuration is region-only (no custom base URLs).
# CROWDSTRIKE_REGION=us-1
# CROWDSTRIKE_CLIENT_ID=00000000000000000000000000000000
# CROWDSTRIKE_CLIENT_SECRET=your-crowdstrike-client-secret
# CROWDSTRIKE_LABEL=Production Falcon

# ======================== Sophos Central Integration (optional) ===============
# Environment variables override the Settings → Integrations UI configuration
# (the UI then cannot change or disconnect Sophos).
# Create a TENANT API credential in Sophos Central → Global Settings → API
# Credentials Management (partner/organization credentials are rejected).
# Role: "Service Principal Read-Only" is enough to sync alerts, SIEM events,
# XDR detections, Health Check and endpoint posture. Auto-resolve in Response
# mode needs "Service Principal Management" (or Super Admin).
# SOPHOS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# SOPHOS_CLIENT_SECRET=your-sophos-client-secret
# SOPHOS_PERMISSION_MODE=read_only   # read_only (default) | response
# SOPHOS_LABEL=Production Sophos

# ======================== Railway.app Deployment ==============================
# Set these in the Railway dashboard (Settings → Variables), not in a .env file.
# See RAILWAY.md for the full deployment walkthrough.
#
# Required (backend service):
#   CLERK_PUBLISHABLE_KEY    — same as above
#   CLERK_SECRET_KEY         — same as above
#   SESSION_SECRET           — generate: openssl rand -base64 32
#   ENCRYPTION_SECRET        — generate: openssl rand -base64 32 (REQUIRED on Railway)
#   CORS_ORIGIN              — https://<your-frontend>.up.railway.app
#   AGENT_SERVER_URL         — https://<your-backend>.up.railway.app
#   NODE_ENV                 — production
#   TESTS_REPO_URL           — https://github.com/ubercylon8/f0_library.git
#   AGENT_REPO_URL           — https://github.com/projectachilles/ProjectAchilles.git (for agent builds)
#   GITHUB_TOKEN             — PAT with repo scope (for private repos)
#
# Elastic Cloud:
#   ELASTICSEARCH_CLOUD_ID   — from Elastic Cloud console
#   ELASTICSEARCH_API_KEY    — from Elastic Cloud console
#
# Required (frontend service):
#   CLERK_PUBLISHABLE_KEY    — same publishable key
#   BACKEND_HOST             — backend.railway.internal
#   BACKEND_PORT             — 3000 (default, usually omit)
